<launch>
  <!-- IFLY2026_FIXED_PATH_PATROL_V14_8_EDGE_DIRECT_OCR_20260817 -->
  <!-- 停靠：巡检识别完成后关闭摄像头 -> 第一段move_base -> 到点重开新会话并立即视觉定位 -> move_base最终停靠。 -->
  <!-- 目标类别只允许 food、daily、electronic，且两者不能相同。 -->
  <arg name="real_target_category" default="food" />
  <arg name="simulation_target_category" default="electronic" />

  <!-- 如果主launch已经启动simple_move_control，请设为false，避免重名。 -->
  <arg name="start_simple_move_control" default="true" />

  <node if="$(arg start_simple_move_control)"
        pkg="ucarmain2026"
        type="simple_move_control"
        name="simple_move_control"
        output="screen">
    <!-- 视觉或主节点阻塞超过0.5秒时，底盘独立自动停车。 -->
    <param name="command_timeout" value="0.50" />
  </node>

  <node pkg="ucarmain2026"
        type="target_patrol_docking"
        name="target_patrol_docking"
        output="screen">
    <param name="real_target_category" value="$(arg real_target_category)" />
    <param name="simulation_target_category"
           value="$(arg simulation_target_category)" />


    <!-- V14.6巡检中心线：
         初始move_base直接到(1.25,4.25,0deg)，不再做旧起点安全横移。
         第一条固定Patrol Path自身也直接从(1.25,4.25)发布：
         1) (1.25,4.25) -> (4.75,4.30)；同步过渡到(4.80,4.30,-90deg)。
         2) x=4.80，到y=2.75；同步过渡到(4.80,2.70,-180deg)。
         3) y=2.70，到x=0.25；同步过渡到(0.20,2.70,+90deg)。
         4) x=0.20，最终停在y=4.25。
         除第一段起点外，所有终点和后续角点均保持V14.5。 -->
    <param name="map_frame" value="map" />
    <param name="base_frame" value="base_link" />
    <param name="scan_topic" value="/scan" />

    <!-- 场地边界。 -->
    <param name="room_min_x" value="0.0" />
    <param name="room_max_x" value="5.0" />
    <param name="room_min_y" value="2.5" />
    <param name="room_max_y" value="4.5" />
    <!-- 初始点位于原巡检线交点，车头沿+x方向向前。 -->
    <param name="start_x" value="1.25" />
    <param name="start_y" value="4.25" />
    <param name="start_yaw_deg" value="0.0" />
    <param name="navigation_timeout" value="180.0" />

    <!--
      巡检不再直接发布速度。主节点按0.02m间隔生成当前投影点到段末的
      nav_msgs/Path，锁定到MyPlanner，然后异步发送同一终点move_base目标。
      四条基准线全部走到真实角点；上一段终点与下一段起点严格重合。
    -->
    <param name="planner_private_namespace" value="/move_base/MyPlanner" />
    <param name="patrol_path_spacing" value="0.02" />
    <param name="patrol_speed_limit" value="0.50" />
    <param name="normal_navigation_speed_limit" value="1.00" />
    <param name="patrol_cancel_timeout" value="3.0" />
    <param name="patrol_interface_timeout" value="3.0" />
    <!--
      固定巡检包含原地换向和连续小幅横移；move_base默认振荡监视会把它们
      误判为oscillation并在约8秒后ABORT。巡检时临时关闭，普通导航时恢复。
      若仍遇到其他瞬时ABORT，最多从当前位置重建剩余Path并续跑2次。
    -->
    <param name="move_base_reconfigure_service"
           value="/move_base/set_parameters" />
    <param name="disable_move_base_oscillation_during_patrol" value="true" />
    <param name="normal_move_base_oscillation_timeout" value="8.0" />
    <param name="patrol_aborted_retry_count" value="2" />
    <param name="segment_end_tolerance" value="0.015" />
    <param name="control_rate" value="15.0" />

    <!-- V12：安全偏移巡检线角点过渡。短距离过渡直接使用/set_speed，
         XY位置与yaw同时闭环，不使用move_base最终姿态调整。 -->
    <param name="patrol_transition_position_kp" value="2.50" />
    <param name="patrol_transition_yaw_kp" value="3.00" />
    <param name="patrol_transition_min_linear_speed" value="0.025" />
    <param name="patrol_transition_max_linear_speed" value="0.12" />
    <param name="patrol_transition_min_angular_speed" value="0.25" />
    <param name="patrol_transition_max_angular_speed" value="1.20" />
    <param name="patrol_transition_linear_accel" value="0.60" />
    <param name="patrol_transition_angular_accel" value="4.00" />
    <!-- V13：角点旋转优先。大角度误差时压低平移，车头转开墙面后逐步恢复线速度。 -->
    <param name="patrol_transition_yaw_priority_start_deg" value="55.0" />
    <param name="patrol_transition_yaw_priority_release_deg" value="20.0" />
    <param name="patrol_transition_yaw_priority_min_linear_scale" value="0.15" />
    <param name="patrol_transition_position_tolerance" value="0.012" />
    <param name="patrol_transition_yaw_tolerance_deg" value="1.5" />
    <param name="patrol_transition_stable_frames" value="3" />
    <param name="patrol_transition_timeout" value="8.0" />
    <!-- NanoDet巡检采用图像左侧三分之二区域；停靠对准仍使用全画面。 -->
    <param name="image_width" value="640" />
    <!-- 640宽、约60度水平视场角时fx约554.256；有标定值时替换这里。 -->
    <param name="camera_fx" value="554.256" />
    <param name="camera_yaw_offset_deg" value="0.0" />
    <!-- 板边界坐标向场地内延伸0.5m，作为move_base停靠导航点。 -->
    <param name="docking_standoff" value="0.50" />
    <param name="settle_time" value="0.25" />
    <param name="ocr_attempts" value="3" />
    <param name="ocr_retry_interval" value="0.12" />
    <!--
      OCR只命中“品/加/工/车/间”而没有类别关键字时，原地逆时针
      转30度并只复识一次。类别关键字：食；日/用；电/子/产/生。
    -->
    <param name="ocr_recovery_turn_deg" value="30.0" />
    <param name="ocr_recovery_turn_kp" value="2.0" />
    <param name="ocr_recovery_turn_min_speed" value="0.18" />
    <param name="ocr_recovery_turn_max_speed" value="0.45" />
    <param name="ocr_recovery_turn_tolerance_deg" value="1.5" />
    <param name="ocr_recovery_turn_stable_frames" value="3" />
    <param name="ocr_recovery_turn_timeout" value="5.0" />
    <param name="ocr_recovery_settle_time" value="0.35" />
    <param name="max_detection_duration" value="0.50" />
    <!-- V14.3保护1仍保留：只有centerX<600的框参与巡检目标判断。 -->
    <param name="patrol_stop_max_center_x" value="600.0" />

    <!--
      V14.5：当前车体左侧正在巡检的墙面目标不再一检测到就停车。

      距离采用：
        当前机器人map位置 -> 相机射线估计出的墙面板坐标
      的欧氏距离，同时要求目标沿当前巡检方向仍在车前方。

      >=1.50m：保持patrol_speed_limit
      1.50m~0.50m：线性减速
      0.70m：速度上限=patrol_speed_limit*0.20，然后取消巡检goal停车OCR

      当前实测参数以本launch实际值为准；本版不修改V14.5减速参数。
      非当前巡检墙目标仍按V14.4原逻辑立即停车。
    -->
    <param name="patrol_target_slowdown_start_distance" value="1.50" />
    <param name="patrol_target_stop_distance" value="0.40" />
    <param name="patrol_target_min_speed_ratio" value="0.20" />

    <!--
      V14.7保护1：
      非当前巡检墙的目标只有在机器人到“该墙本身”的垂直距离
      严格小于1.50m时才允许立即停车。
      例如当前巡检上墙时看见右墙目标：
        distance = room_max_x - robot_x
      >=1.50m时只观察，不停车。
    -->
    <param name="patrol_noncurrent_wall_stop_max_distance" value="1.50" />

    <!--
      V14.8视觉急停：
      当前车体左侧正在巡检的墙上，如果目标框左边界x0严格小于100px，
      说明实车已经进入适合OCR的近距离视野：
        -> 立即取消Patrol并停车
        -> 直接使用触发急停的当前NanoDet框进入OCR
        -> 不执行reacquireApproachBoxAfterStop()二次取框
      普通0.70m map距离停车仍保留停车后二次取框。
    -->
    <param name="patrol_target_left_edge_stop_px" value="100" />

    <!-- 同一墙面上估计坐标相距不超过0.5m，判定为同一块板。 -->
    <param name="duplicate_coordinate_distance" value="0.50" />
    <!--
      超过该距离时记录“大跨度重新捕获”警告，但不再把全画面中的
      有效框直接判为丢失，避免目标进入右侧三分之一后无法恢复跟踪。
    -->
    <param name="max_track_jump_px" value="140.0" />
    <param name="max_lost_frames" value="4" />

    <!--
      到达旧停靠点后，若横移阶段从未看到任何文字板框，以旧停靠朝向
      为基准依次扫描左侧+30度、右侧-30度。每个方向连续检测3次；
      找到后用新框与当前map位姿覆盖旧停靠坐标，并重新导航停靠一次。
    -->
    <!--
      V14.6：第一段临时停靠点的新V4L2画面先只匹配原目标，不先算最终点。
      centerX <= image_width*0.25：先向左/逆时针转30度；
      centerX >= image_width*0.75：先向右/顺时针转30度；
      中间二分之一：不转。
      30度直接复用docking_recovery_turn_deg；转完使用-3缓存刷新后，
      再用新帧计算最终approach_stop_distance停靠点。
    -->
    <param name="docking_recovery_turn_deg" value="30.0" />
    <param name="docking_recovery_detection_attempts" value="3" />
    <param name="docking_recovery_detection_interval" value="0.0" />
    <!-- 第二次视觉只关联同墙且距第一次墙面估计不超过该值的框。 -->
    <param name="docking_refine_max_board_shift" value="0.80" />
    <!-- V14.2：仅±30度恢复旋转后使用-3即时grab；正常第二段依靠第一段前关闭/到点重开摄像头保证新鲜帧。 -->
    <param name="docking_refresh_clear_calls" value="2" />

    <!-- 现实目标先找到时，停靠后直接后退回当前前进巡检线。 -->
    <param name="retreat_line_tolerance" value="0.025" />
    <param name="retreat_slow_distance" value="0.15" />
    <param name="retreat_min_speed" value="0.06" />
    <param name="retreat_max_speed" value="0.18" />
    <param name="retreat_timeout" value="8.0" />

    <!-- 旧版横移参数：V14正常停靠链已不再使用，暂保留便于回退对照。 -->
    <param name="lateral_align_kp" value="0.0010" />
    <param name="lateral_align_min_speed" value="0.06" />
    <param name="lateral_align_max_speed" value="0.20" />
    <param name="lateral_center_tolerance_px" value="10.0" />
    <param name="lateral_stable_frames" value="3" />
    <param name="lateral_align_timeout" value="15.0" />

    <!-- V14中approach_stop_distance不再用于雷达闭环，而直接作为最终
         move_base目标相对板/墙面的法向停靠距离。 -->
    <param name="front_lidar_half_window" value="3" />
    <param name="approach_stop_distance" value="0.28" />
    <param name="approach_slow_distance" value="0.35" />
    <param name="approach_min_speed" value="0.05" />
    <param name="approach_max_speed" value="0.12" />
    <param name="approach_timeout" value="15.0" />
    <param name="lidar_data_timeout" value="0.50" />
    <param name="lidar_loss_abort_timeout" value="2.0" />
    <param name="docking_yaw_kp" value="2.0" />
    <param name="docking_yaw_max_speed" value="0.25" />
  </node>
</launch>