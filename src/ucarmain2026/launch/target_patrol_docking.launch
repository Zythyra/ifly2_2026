<launch>
  <!-- IFLY2026_FIXED_PATH_PATROL_V2_NO_WALL_FIT_20260804 -->
  <!-- 目标类别只允许 food、daily、electronic，且两者不能相同。 -->
  <arg name="real_target_category" default="food" />
  <arg name="simulation_target_category" default="daily" />

  <!-- 如果主launch已经启动simple_move_control，请设为false，避免重名。 -->
  <arg name="start_simple_move_control" default="true" />

  <node if="$(arg start_simple_move_control)"
        pkg="ucarmain2026"
        type="simple_move_control"
        name="simple_move_control"
        output="screen">
    <!-- 视觉或主节点阻塞超过0.5秒时，底盘独立自动停车。 -->
    <param name="command_timeout" value="0.50" />
  </node>

  <node pkg="ucarmain2026"
        type="target_patrol_docking"
        name="target_patrol_docking"
        output="screen">
    <param name="real_target_category" value="$(arg real_target_category)" />
    <param name="simulation_target_category"
           value="$(arg simulation_target_category)" />

    <param name="map_frame" value="map" />
    <param name="base_frame" value="base_link" />
    <param name="scan_topic" value="/scan" />

    <!-- 场地边界。 -->
    <param name="room_min_x" value="0.0" />
    <param name="room_max_x" value="5.0" />
    <param name="room_min_y" value="2.5" />
    <param name="room_max_y" value="4.5" />
    <!-- 初始点位于原巡检线交点，车头沿+x方向向前。 -->
    <param name="start_x" value="0.25" />
    <param name="start_y" value="4.25" />
    <param name="start_yaw_deg" value="0.0" />
    <param name="navigation_timeout" value="180.0" />

    <!--
      巡检不再直接发布速度。主节点按0.02m间隔生成当前投影点到段末的
      nav_msgs/Path，锁定到MyPlanner，然后异步发送同一终点move_base目标。
      四条基准线和提前5cm结束的位置保持不变。
    -->
    <param name="planner_private_namespace" value="/move_base/MyPlanner" />
    <param name="patrol_path_spacing" value="0.02" />
    <param name="patrol_speed_limit" value="0.60" />
    <param name="normal_navigation_speed_limit" value="1.00" />
    <param name="patrol_cancel_timeout" value="3.0" />
    <param name="patrol_interface_timeout" value="3.0" />
    <param name="segment_end_tolerance" value="0.025" />
    <param name="control_rate" value="15.0" />

    <!-- NanoDet巡检采用图像左侧三分之二区域；停靠对准仍使用全画面。 -->
    <param name="image_width" value="640" />
    <!-- 640宽、约60度水平视场角时fx约554.256；有标定值时替换这里。 -->
    <param name="camera_fx" value="554.256" />
    <param name="camera_yaw_offset_deg" value="0.0" />
    <!-- 板边界坐标向场地内延伸0.5m，作为move_base停靠导航点。 -->
    <param name="docking_standoff" value="0.50" />
    <param name="settle_time" value="0.25" />
    <param name="ocr_attempts" value="3" />
    <param name="ocr_retry_interval" value="0.12" />
    <param name="max_detection_duration" value="0.50" />
    <!-- 同一墙面上估计坐标相距不超过0.5m，判定为同一块板。 -->
    <param name="duplicate_coordinate_distance" value="0.50" />
    <!--
      超过该距离时记录“大跨度重新捕获”警告，但不再把全画面中的
      有效框直接判为丢失，避免目标进入右侧三分之一后无法恢复跟踪。
    -->
    <param name="max_track_jump_px" value="140.0" />
    <param name="max_lost_frames" value="4" />

    <!-- 现实目标先找到时，停靠后直接后退回当前前进巡检线。 -->
    <param name="retreat_line_tolerance" value="0.025" />
    <param name="retreat_slow_distance" value="0.15" />
    <param name="retreat_min_speed" value="0.06" />
    <param name="retreat_max_speed" value="0.18" />
    <param name="retreat_timeout" value="8.0" />

    <!-- 旧稳定版二段式停靠参数。 -->
    <param name="lateral_align_kp" value="0.0010" />
    <param name="lateral_align_min_speed" value="0.06" />
    <param name="lateral_align_max_speed" value="0.20" />
    <param name="lateral_center_tolerance_px" value="10.0" />
    <param name="lateral_stable_frames" value="3" />
    <param name="lateral_align_timeout" value="15.0" />

    <param name="front_lidar_half_window" value="3" />
    <param name="approach_stop_distance" value="0.20" />
    <param name="approach_slow_distance" value="0.35" />
    <param name="approach_min_speed" value="0.05" />
    <param name="approach_max_speed" value="0.12" />
    <param name="approach_timeout" value="15.0" />
    <param name="lidar_data_timeout" value="0.50" />
    <param name="lidar_loss_abort_timeout" value="2.0" />
    <param name="docking_yaw_kp" value="2.0" />
    <param name="docking_yaw_max_speed" value="0.25" />
  </node>
</launch>
