<launch>

  <!-- Run the map server -->
   
  <include file="$(find ucar_controller)/launch/base_driver.launch" > </include>
  
  <include file="$(find ydlidar)/launch/ydlidar.launch" > </include>
  <!-- <arg name="map_file" default="$(find ucar_map)/maps/map2026.yaml"/> -->
  <arg name="map_file" default="$(find ucar_map)/maps/map2026_2.yaml"/>
  
  <!-- 起点坐标 -->
  <arg name="initial_pose_x" default="2.25"/>
  <arg name="initial_pose_y" default="5.75"/>
  <arg name="initial_pose_a" default="0.0"/>
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen">
  
  <param name="frame_id" value="map" />
  </node> 

  <include file="$(find ucar_nav)/launch/config/amcl/amcl_omini_test.launch" > 
    <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
  
  </include>
    <!-- move_base -->
    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <!-- 选择全局路径规划 -->
      <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
      <rosparam file="$(find ucar_nav)/launch/config/xys/costmap_common_params.yaml" command="load" ns="global_costmap" />

      <!-- 选择局部路径规划 -->
      <!-- <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
      <rosparam file="$(find ucar_nav)/launch/config/xys_1/dwa_local_planner_params.yaml" command="load" /> -->

      <!-- <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>
      <rosparam file="$(find ucar_nav)/launch/config/xys/teb_local_planner_params_2026.yaml" command="load" /> -->
      <param name="base_local_planner" value="my_planner/MyPlanner" />
      <rosparam file="$(find my_planner)/config/my_planner_params.yaml" command="load" ns="MyPlanner" />
      <!-- <rosparam file="$(find my_planner)/config/my_planner_params_2.yaml" command="load" ns="MyPlanner" /> -->
      <!-- <rosparam file="$(find ucar_nav)/launch/config/xys_1/costmap_converter_params.yaml" command="load" /> -->

    <!-- 地图参数配置 -->
      <rosparam file="$(find ucar_nav)/launch/config/xys/move_base_params.yaml" command="load"/>
      <rosparam file="$(find ucar_nav)/launch/config/xys/costmap_common_params.yaml" command="load" ns="local_costmap" />
      <rosparam file="$(find ucar_nav)/launch/config/xys/base_global_planner_params.yaml" command="load" />
      <rosparam file="$(find ucar_nav)/launch/config/xys/local_costmap_params.yaml" command="load" />
      <rosparam file="$(find ucar_nav)/launch/config/xys/global_costmap_params.yaml" command="load" />
    </node>

    <!-- <rosparam file="$(find ucar_nav)/launch/config/move_base/costmap_converter_params.yaml" command="load" /> -->

</launch>
