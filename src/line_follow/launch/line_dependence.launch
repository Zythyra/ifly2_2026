<launch>
    <!--
        两个节点共用同一个 YAML 文件，但分别加载到各自命名空间。
        line_right 只读取原赛道参数；line2_right 只读取新赛道参数。
    -->
    <rosparam
        command="load"
        file="$(find line_follow)/config/line.yaml"
        ns="line_right"/>

    <rosparam
        command="load"
        file="$(find line_follow)/config/line.yaml"
        ns="line2_right"/>

    <!-- 两个节点使用同一份相机标定文件 -->
    <param
        name="/line_right/calibration_file"
        value="$(find line_follow)/camera_info/pinhole.yaml"/>

    <param
        name="/line2_right/calibration_file"
        value="$(find line_follow)/camera_info/pinhole.yaml"/>

    <!-- 位姿获取服务：/getpose_server -->
    <node
        pkg="ucarmain2026"
        type="tf_pose_get"
        name="tf_pose_get"
        output="screen"
        respawn="false"/>

    <!-- 原赛道右侧巡线服务：/line_right -->
    <node
        pkg="line_follow"
        type="line_right"
        name="line_right"
        output="screen"
        respawn="false"/>

    <!-- 新赛道右侧巡线服务：/line2_right -->
    <node
        pkg="line_follow"
        type="line2_right"
        name="line2_right"
        output="screen"
        respawn="false"/>
</launch>