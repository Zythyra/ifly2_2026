<launch>
    <node pkg="ydlidar" type="locate_pic_ransac" name="locate_pic_ransac" output="screen">
        
        <remap from="/scan" to="/scan"/> 
        <param name="control" value="0"/>
        <!-- <param name="distance_front" value="0.35"/> -->
        <param name="distance_front" value="0.365"/>
        <param name="distance_back" value="-0.405"/>
        <param name="window_size" value="2"/>
        <param name="min_valid_range" value="0.12"/>
        <param name="max_valid_range" value="10.0"/>
        <param name="target_width" value="0.5"/>
        <param name="continuity_threshold" value="0.15"/>
        <param name="linearity_threshold" value="0.02"/>

    </node>

</launch>